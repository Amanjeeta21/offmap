{
  "expo": {
    "name": "OFFMAP",
    "slug": "offmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "offmap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.amanjeeta.offmap",
      "buildNumber": "1",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.amanjeeta.offmap",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
  "expo-router",
  [
    "expo-splash-screen",
    {
      "backgroundColor": "#F7F5F0",
      "image": "./assets/images/splash-icon.png",
      "imageWidth": 76
    }
  ],
  [
    "expo-location",
    {
      "locationWhenInUsePermission": "Allow OFFMAP to access your location when you tap Replan, so it can find nearby places and plan your itinerary."
    }
  ]
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "507b967e-5f06-4d9c-971a-5db90a8cbe53"
      }
    }
  }
}
